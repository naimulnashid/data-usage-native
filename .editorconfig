root = true

# Only C#: the task XML is UTF-16 on purpose, and a blanket charset rule
# would let an editor re-encode it.
[*.cs]
# Dead code. Suggestions, so the IDE and `dotnet format` report them without
# failing a build (warnings are errors here).
dotnet_diagnostic.IDE0051.severity = suggestion
dotnet_diagnostic.IDE0052.severity = suggestion
dotnet_diagnostic.IDE0060.severity = suggestion
